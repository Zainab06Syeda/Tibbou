# API database user. Use the Supabase session pooler for a persistent process.
DATABASE_URL=postgresql://tibbou_api_login.project-ref:password@pooler-host:5432/postgres
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=0
# Production requires the bundled Supabase CA file for sslmode=verify-full.
# DATABASE_SSL_ROOT_CERT=/var/app/current/certs/supabase-ca.crt

# Supabase Auth. Only the project URL and publishable key may be exposed to browsers.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Comma-separated browser origins. Leave empty behind a same-origin reverse proxy.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

MAX_DBT_MANIFEST_BYTES=10485760
MAX_DBT_MANIFEST_NODES=50000
SNOWFLAKE_STATEMENT_TIMEOUT_SECONDS=30
