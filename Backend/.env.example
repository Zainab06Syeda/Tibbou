# Runtime database user. Use the Supabase transaction pooler in hosted environments.
DATABASE_URL=postgresql://tibbou_app:password@host:6543/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Supabase Auth. Only the project URL and publishable key may be exposed to browsers.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Comma-separated browser origins. Leave empty behind a same-origin reverse proxy.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

MAX_DBT_MANIFEST_BYTES=10485760
MAX_DBT_MANIFEST_NODES=50000
SNOWFLAKE_STATEMENT_TIMEOUT_SECONDS=30
