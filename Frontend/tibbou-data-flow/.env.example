VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Authentication feature flags default to disabled when omitted.
# Enable Entra only after its hosted provider and callback have been verified.
VITE_ENABLE_ENTRA_SSO=false
# Reserved for a later phase; this does not enable Okta yet.
VITE_ENABLE_OKTA_SSO=false
